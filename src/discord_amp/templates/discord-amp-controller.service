[Unit]
Description=Discord game job controller
After=network-online.target discord-amp-tunnel.service
Wants=network-online.target discord-amp-tunnel.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=exec
User=discord-amp-controller
Group=discord-amp-controller
ExecStart=/opt/discord-amp-controller/.venv/bin/python -B -m discord_amp.runtime controller
LoadCredential=broker-token:/etc/discord-amp-controller/credentials/broker-token
StateDirectory=discord-amp-controller
StateDirectoryMode=0700
RuntimeDirectory=discord-amp-controller
RuntimeDirectoryMode=0750
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=@@HOST_IPV4@@/32
IPAddressAllow=@@BROADCAST@@/32
MemoryMax=192M
TasksMax=32
Restart=on-failure
RestartSec=10
TimeoutStopSec=10
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
