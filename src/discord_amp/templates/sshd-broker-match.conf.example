# Candidate gameserver-only Match block. Validate sshd -t/-T before reload.
# New nonroot account; its authorized_keys gets ONLY the new automation public
# key, with restrict,port-forwarding,permitopen="127.0.0.1:@@BROKER_PORT@@" key options.
# Existing Windows administrative keys/accounts are untouched.
Match User discord-amp-tunnel
    AuthenticationMethods publickey
    PasswordAuthentication no
    KbdInteractiveAuthentication no
    AllowTcpForwarding local
    AllowStreamLocalForwarding no
    PermitOpen 127.0.0.1:@@BROKER_PORT@@
    PermitListen none
    MaxSessions 0
    PermitTTY no
    PermitUserRC no
    AllowAgentForwarding no
    X11Forwarding no
    GatewayPorts no
Match all
